{
  "name": "the-reserve",
  "private": true,
  "packageManager": "npm@10.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo check-types",
    "test": "turbo test",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "build:check": "node scripts/build-check.mjs",
    "app:start": "node scripts/ci-start-app.mjs",
    "app:stop": "node scripts/ci-start-app.mjs --stop",
    "db:types": "supabase gen types typescript --linked > apps/reserve/shared/types/database.ts",
    "db:push": "supabase db push && npm run db:types && npm run db:docs",
    "db:migrations": "supabase migration list",
    "db:docs": "dotenv -e apps/reserve/.env -- tbls doc --force -c .tbls.yml",
    "verify:ask": "node scripts/verify-ask.mjs",
    "verify:presets": "node --experimental-strip-types scripts/verify-presets.mjs",
    "verify:forms": "node scripts/verify-forms.mjs",
    "verify:leads": "node --experimental-strip-types scripts/verify-leads.mjs",
    "verify:messages": "node scripts/verify-messages.mjs",
    "verify:tables": "node --experimental-strip-types scripts/verify-tables.mjs",
    "verify:ledger": "node scripts/verify-ledger.mjs",
    "verify:audit": "node scripts/verify-audit.mjs",
    "verify:policies": "node scripts/verify-policies.mjs",
    "verify:build-secrets": "node --experimental-strip-types scripts/verify-build-secrets.mjs",
    "schema:compare": "node scripts/schema-compare.mjs",
    "seed:tables": "node scripts/seed-tables-load.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "bench:tables": "node scripts/bench-tables.mjs",
    "e2e:forms": "node scripts/e2e-forms.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@supabase/ssr": "^0.12.7",
    "dotenv-cli": "^11.0.0",
    "supabase": "^2.113.0",
    "turbo": "^2.11.7"
  }
}
